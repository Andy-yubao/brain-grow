{
  "version": "h1_nodes_nonzero_v1",
  "model_seed": 11,
  "data_seed": 20261004,
  "source_run": "experiments/runs/pruning_v1/mnist_static",
  "source_arm": "fc",
  "arms": ["fixed", "reduce", "random"],
  "epochs": 6,
  "batch_size": 64,
  "evaluation_batch_size": 512,
  "learning_rate": 0.00025,
  "lr_milestones": [4],
  "weight_decay": 0.0,
  "screen_samples": 256,
  "accuracy_tolerance": 0.01,
  "loss_tolerance": 0.05,
  "max_remove": 8,
  "max_relative_residual": 0.05,
  "nonzero_fit_activation_rule": "L2_norm_strictly_positive",
  "minimum_coefficient_abs": 1e-8,
  "minimum_reconstruction_coefficients": 2,
  "fixed_C32_rule": "reject_main_before_adaptation_if_fewer_than_two_abs_above_1e-8; normal_original_model_update",
  "fixed_reference_cost_rule": "repeat_same_six_epochs_from_old_FC25_as_registered_control_cost; not_new_mechanism_effect",
  "activation_partition": "each_digit_first_256_fit_last_64_holdout_of_existing_fit_order",
  "candidate_schedule": [
    {"epoch": 2, "layer_index": 0},
    {"epoch": 4, "layer_index": 1},
    {"epoch": 6, "layer_index": 0}
  ],
  "adam_reset_rule": "all_arms_after_49_ordinary_updates_before_final_batch_in_candidate_epochs",
  "random_rule": "match_actual_accepted_slot_layer_and_removed_nodes; uniform_identity; fit_activation_lstsq_compensation; no_select_acceptance",
  "random_rng": "SeedSequence([11, epoch, source_proposal, layer_index])",
  "maximum_wall_seconds": 1800,
  "confirmation_role": "repeated_exploratory_existing_control_after_all_arms_frozen"
}
