{
  "version": "h1_path_sparsity_v1",
  "model_seed": 11,
  "data_seed": 20261004,
  "widths": [784, 512, 256, 10],
  "arms": ["fc", "plain_prune", "path_fixed", "path_prune", "path_random"],
  "epochs": 25,
  "batch_size": 64,
  "evaluation_batch_size": 512,
  "learning_rate": 0.001,
  "weight_decay": 0.0,
  "lr_milestones": [11, 21],
  "warmup_epochs": 5,
  "regularizer_full_epoch": 15,
  "lambda_max": 0.05,
  "node_remove_fraction": 0.04,
  "screen_samples": 256,
  "accuracy_tolerance": 0.01,
  "loss_tolerance": 0.05,
  "learning_floor": 0.90,
  "minimum_storage_reduction": 0.05,
  "candidate_schedule": [
    {"epoch": 10, "layer_index": 0},
    {"epoch": 15, "layer_index": 1},
    {"epoch": 20, "layer_index": 0},
    {"epoch": 25, "layer_index": 1}
  ],
  "adam_reset_rule": "all_five_arms_after_49_normal_batches_in_candidate_epochs",
  "regularizer": "sum_hidden_group_full_squared_path_l2_norms; biases_as_constant_inputs; frozen_initial_width_denominators_and_R0",
  "plain_reference": ["fc"],
  "path_reference": ["fc", "path_fixed"],
  "random_rng": "SeedSequence([11, epoch, source_proposal, layer_index])",
  "maximum_wall_seconds": 1800,
  "confirmation_role": "重复探索已有1000control，只在五臂全部末态冻结后评价一次"
}
